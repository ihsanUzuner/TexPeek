#pragma code_page(65001)
// Bu dosyadan CMake iki kaynak dosyası üretir: biri texpeek.exe, biri TexPeekThumb.dll için.
// Windows'ta dosyaya sağ tık > Özellikler > Ayrıntılar'da görünen bilgiler ve exe'nin simgesi buradan gelir.
// @...@ arasındaki yerleri CMakeLists.txt doldurur; sürüm numarası kökteki VERSION dosyasından okunur.
#include <winver.h>

@RC_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        @RC_FILETYPE@
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "@RC_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@RC_FILENAME@"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Ihsan Uzuner"
            VALUE "OriginalFilename", "@RC_FILENAME@"
            VALUE "ProductName",      "TexPeek"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
